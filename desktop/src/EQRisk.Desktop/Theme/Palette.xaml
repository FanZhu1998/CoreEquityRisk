<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- The dark palette of fan-zhu.com (fanzhu-site/assets/css/style.css), the same tokens the
         Streamlit workbench uses. Contrast against the page colour is noted where the site notes it. -->
    <Color x:Key="PageColor">#080E18</Color>
    <Color x:Key="SurfaceColor">#0D1523</Color>
    <Color x:Key="Surface2Color">#121D2E</Color>
    <Color x:Key="Surface3Color">#1A273A</Color>
    <Color x:Key="InkColor">#E8EEF7</Color>          <!-- 16.57:1 -->
    <Color x:Key="Ink2Color">#A7B8CE</Color>
    <Color x:Key="MutedColor">#7F92A9</Color>        <!-- 6.06:1 -->
    <Color x:Key="AccentColor">#7DABDD</Color>       <!-- 8.05:1 -->
    <Color x:Key="AccentHiColor">#A7C8EE</Color>     <!-- 11.17:1 -->
    <Color x:Key="Accent2Color">#628AB8</Color>
    <Color x:Key="BullColor">#46BF94</Color>         <!-- 8.41:1 -->
    <Color x:Key="BearColor">#E5776C</Color>         <!-- 6.62:1 -->
    <Color x:Key="WarnColor">#E2B86B</Color>
    <Color x:Key="LineColor">#1AE8EEF7</Color>       <!-- ink at 10% -->
    <Color x:Key="Line2Color">#29E8EEF7</Color>      <!-- ink at 16% -->
    <Color x:Key="AccentDimColor">#247DABDD</Color>  <!-- accent at 14% -->
    <Color x:Key="OnAccentColor">#080E18</Color>

    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHiBrush" Color="{StaticResource AccentHiColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="BullBrush" Color="{StaticResource BullColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="BearBrush" Color="{StaticResource BearColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" po:Freeze="True" />

    <!-- Tints for pills and status chips: the tone at low alpha behind the tone as text. -->
    <SolidColorBrush x:Key="BullDimBrush" Color="#2446BF94" po:Freeze="True" />
    <SolidColorBrush x:Key="BearDimBrush" Color="#24E5776C" po:Freeze="True" />
    <SolidColorBrush x:Key="WarnDimBrush" Color="#24E2B86B" po:Freeze="True" />
    <SolidColorBrush x:Key="MutedDimBrush" Color="#1F7F92A9" po:Freeze="True" />

</ResourceDictionary>
