<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:EQRisk.Desktop.Views"
                    xmlns:p="clr-namespace:EQRisk.Desktop.Views.Pages"
                    xmlns:vm="clr-namespace:EQRisk.Presentation.Pages;assembly=EQRisk.Presentation">

    <!-- Converters every view uses. -->
    <v:ToneBrushConverter x:Key="ToneBrush" />
    <v:ToneBrushConverter x:Key="ToneDimBrush" Dim="True" />
    <v:VisibleWhenConverter x:Key="VisibleWhen" />
    <v:VisibleWhenConverter x:Key="HiddenWhen" Invert="True" />
    <v:NotConverter x:Key="Not" />
    <v:UpperConverter x:Key="Upper" />
    <v:DataSourceTextConverter x:Key="DataSourceText" />
    <v:YearsTextConverter x:Key="YearsText" />
    <v:PageGlyphConverter x:Key="PageGlyph" />
    <v:SignBrushConverter x:Key="SignBrush" />

    <!-- A figure in a page's stat rail. -->
    <DataTemplate DataType="{x:Type vm:Stat}">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,13,16,14" Margin="0,0,10,16" ToolTip="{Binding Hint}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label, Converter={StaticResource Upper}}"
                           Margin="0,0,0,7" />
                <TextBlock Style="{StaticResource Figure}" Text="{Binding Value}"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <Style x:Key="StatRail" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="0,0,-10,0" />
    </Style>

    <!-- A PASS/FAIL or ok/missing chip. -->
    <DataTemplate x:Key="PillTemplate">
        <Border Style="{StaticResource Pill}" Background="{Binding Tone, Converter={StaticResource ToneDimBrush}}">
            <TextBlock Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Medium"
                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
        </Border>
    </DataTemplate>

    <!-- Pages. -->
    <DataTemplate DataType="{x:Type vm:TodayViewModel}"><p:TodayView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DataViewModel}"><p:DataView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:EstimateViewModel}"><p:EstimateView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ValidateViewModel}"><p:ValidateView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FactorReturnsViewModel}"><p:FactorReturnsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FactorRiskViewModel}"><p:FactorRiskView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExposuresViewModel}"><p:ExposuresView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SpecificRiskViewModel}"><p:SpecificRiskView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PortfolioViewModel}"><p:PortfolioView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OptimizerViewModel}"><p:OptimizerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:JobsViewModel}"><p:JobsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PublishViewModel}"><p:PublishView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><p:SettingsView /></DataTemplate>

</ResourceDictionary>
