<Window x:Class="EQRisk.Desktop.Views.SecretDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="EQRisk">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="18" MouseLeftButtonDown="OnDrag" />
        <TextBlock x:Name="Message" Grid.Row="1" Style="{StaticResource Body}" Foreground="{StaticResource Ink2Brush}"
                   LineHeight="21" Margin="0,2,0,16" />
        <PasswordBox x:Name="Secret" Grid.Row="2" FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="8,6"
                     PasswordChanged="OnChanged" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,20">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="13" Foreground="{StaticResource BullBrush}"
                       Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource Note}" Text="Encrypted for your Windows account with DPAPI. It is never shown again." />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True"
                    IsEnabled="False" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
