<UserControl x:Class="EQRisk.Desktop.Views.Pages.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EQRisk.Desktop.Views.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="StatusCell">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PillTemplate}" Margin="10,0" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <c:PageHeader />
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Jobs this app ran">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Card}" Padding="8,8">
                      <Grid>
                        <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STARTED" Binding="{Binding Started}" Width="140" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="JOB" Binding="{Binding Label}" Width="*" ElementStyle="{StaticResource TextCell}" />
                                <DataGridTemplateColumn Header="STATUS" Width="115" CellTemplate="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="TOOK" Binding="{Binding Duration}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="BY" Binding="{Binding Trigger}" Width="85" ElementStyle="{StaticResource TextCell}" />
                                <DataGridTextColumn Header="COMMAND" Binding="{Binding Command}" Width="2*" ElementStyle="{StaticResource TextCell}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Note}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="480" TextWrapping="Wrap" IsHitTestVisible="False"
                                   Text="No jobs yet. A job started here, from the tray icon or by the daily schedule is listed here with its full log."
                                   Visibility="{Binding Jobs, Converter={StaticResource HiddenWhen}}" />
                      </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Open log file" Command="{Binding OpenLogFileCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Log" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Height="380" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource Ink2Brush}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Pipeline runs">
                <Border Style="{StaticResource Card}" Padding="8,8" Margin="0,16,0,0">
                    <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Runs}" Height="620">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STARTED" Binding="{Binding Started}" Width="140" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="COMMAND" Binding="{Binding Command}" Width="*" ElementStyle="{StaticResource TextCell}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                            <DataGridTextColumn Header="SESSION" Binding="{Binding Session}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTemplateColumn Header="STATUS" Width="130" CellTemplate="{StaticResource StatusCell}" />
                            <DataGridTextColumn Header="GATES" Binding="{Binding Gates}" Width="200" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="MIN" Binding="{Binding Minutes}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
