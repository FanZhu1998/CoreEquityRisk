<UserControl x:Class="EQRisk.Desktop.Views.Pages.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EQRisk.Desktop.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,28,18" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <c:PageHeader />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <UniformGrid Columns="3">
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="METHOD" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TILT TOWARD" />
                        <ComboBox ItemsSource="{Binding Tilts}" SelectedItem="{Binding Tilt}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}" IsEnabled="{Binding HasTilt}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding AlphaPercent, StringFormat={}{0:0.00}% a month}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="ALPHA PER UNIT OF EXPOSURE" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="5" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding AlphaPercent}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding TrackingErrorPercent, StringFormat={}{0:0.0}%}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TRACKING-ERROR CAP, ANNUALIZED" />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding TrackingErrorPercent}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding StyleBand, StringFormat=± {0:0.00}}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="STYLE EXPOSURE BAND" />
                        </DockPanel>
                        <Slider Minimum="0.05" Maximum="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding StyleBand}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding IndustryBand, StringFormat=± {0:0.00}}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="INDUSTRY EXPOSURE BAND" />
                        </DockPanel>
                        <Slider Minimum="0.01" Maximum="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding IndustryBand}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding MaxWeightPercent, StringFormat={}{0:0}%}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="MAXIMUM WEIGHT" />
                        </DockPanel>
                        <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxWeightPercent}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding Turnover, StringFormat={}{0:0.0}}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TURNOVER LIMIT AGAINST THE BENCHMARK (L1)" />
                        </DockPanel>
                        <Slider Minimum="0.1" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Turnover}" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeCommand}" IsEnabled="{Binding IsSolving, Converter={StaticResource Not}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" FontSize="13" Margin="0,0,9,0"
                                       Foreground="{StaticResource OnAccentBrush}" />
                            <TextBlock Text="Optimize" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Note}" Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,12,0,0" BorderThickness="0"
                             Visibility="{Binding IsSolving, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
            <ItemsControl ItemsSource="{Binding Stats}" Style="{StaticResource StatRail}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Active exposures" />
                        <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Exposures}" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FACTOR" Binding="{Binding Factor}" Width="*" ElementStyle="{StaticResource TextCell}" />
                                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="90" ElementStyle="{StaticResource TextCell}" />
                                <DataGridTextColumn Header="EXPOSURE" Binding="{Binding Exposure}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="VOLATILITY" Binding="{Binding Volatility}" Width="95" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="% VARIANCE" Binding="{Binding Share}" Width="95" ElementStyle="{StaticResource NumberCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Holdings" />
                        <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Result}" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TICKER" Binding="{Binding Ticker}" Width="*" ElementStyle="{StaticResource TextCell}" />
                                <DataGridTextColumn Header="WEIGHT" Binding="{Binding Weight}" Width="80" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="BENCHMARK" Binding="{Binding Benchmark}" Width="95" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="ACTIVE" Binding="{Binding Active}" Width="80" ElementStyle="{StaticResource NumberCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
