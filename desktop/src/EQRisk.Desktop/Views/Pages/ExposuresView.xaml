<UserControl x:Class="EQRisk.Desktop.Views.Pages.ExposuresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EQRisk.Desktop.Views.Controls">
    <StackPanel>
        <c:PageHeader />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="AS OF" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <DatePicker SelectedDate="{Binding AsOf}" DisplayDateStart="{Binding FirstDate}" DisplayDateEnd="{Binding LastDate}" Width="160" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FIND" VerticalAlignment="Center" Margin="24,0,12,0" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="A ticker, or part of an industry" />
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="{Binding Summary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8,8">
                <DataGrid x:Name="Grid" Style="{StaticResource Table}" ItemsSource="{Binding Table}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="True" AutoGeneratingColumn="OnColumn" Height="600" FrozenColumnCount="1" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Selected name" />
                    <TextBlock Style="{StaticResource Note}" Text="Pick a row to see its style exposures, in standard deviations."
                               Visibility="{Binding SelectedExposures, Converter={StaticResource HiddenWhen}}" />
                    <c:ChartView Chart="{Binding SelectedExposures}" Height="440"
                                 Visibility="{Binding SelectedExposures, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
