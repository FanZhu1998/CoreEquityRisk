<UserControl x:Class="EQRisk.Desktop.Views.Pages.ValidateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EQRisk.Desktop.Views.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ScoreStatus">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PillTemplate}" Margin="10,0" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <c:PageHeader />

        <Border Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FIRST FORECAST" />
                    <DatePicker SelectedDate="{Binding Start}" Width="160" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="LAST FORECAST" />
                    <DatePicker SelectedDate="{Binding End}" Width="160" />
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Bottom" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" FontSize="13" Margin="0,0,9,0"
                                   Foreground="{StaticResource OnAccentBrush}" />
                        <TextBlock Text="Run validation" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Content="Open report folder" Margin="12,0,0,2" VerticalAlignment="Bottom"
                        Command="{Binding OpenReportCommand}" Visibility="{Binding HasReport, Converter={StaticResource VisibleWhen}}" />
            </WrapPanel>
        </Border>

        <TextBlock Style="{StaticResource Note}" Text="No report yet: run a validation above. It takes a few minutes."
                   Visibility="{Binding HasReport, Converter={StaticResource HiddenWhen}}" />

        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource VisibleWhen}}">
            <ItemsControl ItemsSource="{Binding Stats}" Style="{StaticResource StatRail}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Success criteria (§1.3)" />
                    <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Scorecard}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="150" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="CRITERION" Binding="{Binding Criterion}" Width="*" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="MEASURED" Binding="{Binding Value}" Width="260" ElementStyle="{StaticResource LongTextCell}" />
                            <DataGridTemplateColumn Header="STATUS" Width="100" CellTemplate="{StaticResource ScoreStatus}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="External checks (§11.3)" />
                    <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding External}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="150" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="CHECK" Binding="{Binding Criterion}" Width="*" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="MEASURED" Binding="{Binding Value}" Width="260" ElementStyle="{StaticResource LongTextCell}" />
                            <DataGridTemplateColumn Header="STATUS" Width="100" CellTemplate="{StaticResource ScoreStatus}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Pure factor portfolios: bias statistic" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                               Text="Between the dotted lines (1 ± √(2/T)) a factor's risk forecast was right to within sampling error." />
                    <c:ChartView Chart="{Binding FactorBias}" Height="660" />
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Eigenfactor portfolios" />
                        <TextBlock Style="{StaticResource Note}" Text="The eigen adjustment flattens the smile of the smallest-variance portfolios." Margin="0,0,0,8" />
                        <c:ChartView Chart="{Binding Eigen}" Height="280" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Specific risk by decile" />
                        <TextBlock Style="{StaticResource Note}" Text="Bias statistic by size and volatility decile, full stack against time series only." Margin="0,0,0,8" />
                        <c:ChartView Chart="{Binding Deciles}" Height="280" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
