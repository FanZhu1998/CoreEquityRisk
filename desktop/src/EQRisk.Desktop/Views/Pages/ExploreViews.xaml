<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The as-of bar every Explore page opens with. The date snaps to the nearest model date on or before it. -->
    <DataTemplate x:Key="AsOfBar">
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="AS OF" VerticalAlignment="Center" Margin="0,0,12,0" />
                <DatePicker SelectedDate="{Binding AsOf}" DisplayDateStart="{Binding FirstDate}" DisplayDateEnd="{Binding LastDate}" Width="160" />
                <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Text="Defaults to the latest published session." />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
