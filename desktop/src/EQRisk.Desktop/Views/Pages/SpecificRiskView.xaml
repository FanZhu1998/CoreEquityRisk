<UserControl x:Class="EQRisk.Desktop.Views.Pages.SpecificRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EQRisk.Desktop.Views.Controls">
    <StackPanel>
        <c:PageHeader />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="AS OF" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <DatePicker SelectedDate="{Binding AsOf}" DisplayDateStart="{Binding FirstDate}" DisplayDateEnd="{Binding LastDate}" Width="160" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FIND" VerticalAlignment="Center" Margin="24,0,12,0" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="A ticker, or part of an industry" />
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="{Binding Summary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8,8">
                <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Rows}" Height="600" FrozenColumnCount="1"
                          MouseDoubleClick="OnRowActivated"
                          ToolTip="Double-click a name to add it to the factor-exposure comparison">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TICKER" Binding="{Binding Ticker}" Width="80" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="INDUSTRY" Binding="{Binding Industry}" Width="*" MinWidth="160" ElementStyle="{StaticResource TextCell}" />
                        <DataGridCheckBoxColumn Header="ESTU" Binding="{Binding InEstu}" Width="60" />
                        <DataGridTextColumn Header="TIME SERIES" Binding="{Binding TimeSeries, StringFormat={}{0:P1}, TargetNullValue=—}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="STRUCTURAL" Binding="{Binding Structural, StringFormat={}{0:P1}, TargetNullValue=—}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="BLEND" Binding="{Binding Blend, StringFormat={}{0:P1}, TargetNullValue=—}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="FINAL" Binding="{Binding Final, StringFormat={}{0:P1}, TargetNullValue=—}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="γ" Binding="{Binding Gamma, StringFormat={}{0:0.00}, TargetNullValue=—}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Final specific volatility" />
                    <TextBlock Style="{StaticResource Note}" Text="Names by annualized specific volatility." Margin="0,0,0,8" />
                    <c:ChartView Chart="{Binding Distribution}" Height="340" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding Compare.IsOpen, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Every factor" IsChecked="{Binding Compare.ShowEveryFactor}" VerticalAlignment="Center" Margin="0,0,14,0"
                                  ToolTip="Also show the industries every chosen name scores zero on" />
                        <Button Content="Clear" Command="{Binding CloseCompareCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Factor exposures" />
                </DockPanel>
                <TextBlock Style="{StaticResource Note}" Text="{Binding Compare.Summary}" />
                <TextBlock Style="{StaticResource Note}" Text="{Binding Compare.Problem}" Margin="0,4,0,0"
                           Visibility="{Binding Compare.Problem, Converter={StaticResource VisibleWhen}}" />
                <ItemsControl ItemsSource="{Binding Compare.Securities}" Margin="0,10,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#14E8EEF7" CornerRadius="3" Padding="9,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Ticker}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalRisk, StringFormat=P1}" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Total annualized risk" />
                                    <Button Content="&#x2715;" Margin="10,0,0,0" Padding="5,0" ToolTip="Remove from the comparison"
                                            Command="{Binding DataContext.HideSecurityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Ticker}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Compare.Table}" MaxHeight="520"
                          AutoGenerateColumns="True" AutoGeneratingColumn="OnCompareColumn" FrozenColumnCount="2" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
