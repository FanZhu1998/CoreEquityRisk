<Window x:Class="EQRisk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:EQRisk.Desktop.Views.Controls"
        Title="EQRisk" Width="1380" Height="900" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The navigation rail. -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                    <Image Source="/Assets/eqrisk-mark.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EQRisk" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="Equity factor risk" Style="{StaticResource Label}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="12,10"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <DockPanel>
                        <Ellipse x:Name="EngineDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource Note}" FontSize="12" Foreground="{StaticResource Ink2Brush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <ListBox x:Name="Nav" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource Label}"
                                               Margin="14,18,0,6" Visibility="{Binding Name, Converter={StaticResource VisibleWhen}}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Width="28"
                                           Text="{Binding Page.Key, Converter={StaticResource PageGlyph}}" />
                                <TextBlock Text="{Binding Page.Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The page, and the activity bar under it. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding Current}" Margin="46,34,46,30" MaxWidth="1280" HorizontalAlignment="Stretch"
                                Focusable="False" />
            </ScrollViewer>
            <c:ActivityBar Grid.Row="1" DataContext="{Binding Activity}" />
        </Grid>
    </Grid>
</Window>
