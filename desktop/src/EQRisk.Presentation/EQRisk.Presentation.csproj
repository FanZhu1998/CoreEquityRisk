<Project Sdk="Microsoft.NET.Sdk">

  <!-- View models: what each screen shows and what its buttons do, with no WPF types. Plain net10.0,
       so they run in unit tests without a window, and the XAML layer stays a thin skin. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EQRisk.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQRisk.Core\EQRisk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
