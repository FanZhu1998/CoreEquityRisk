<Project>
  <!-- Shared by every project under desktop/. Package versions live in Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <Product>EQRisk</Product>
    <Company>Fan Zhu</Company>
    <Authors>Fan Zhu</Authors>
    <Copyright>Copyright (c) 2026 Fan Zhu. MIT licence.</Copyright>
    <Version>0.2.0</Version>
  </PropertyGroup>
</Project>
