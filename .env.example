# Copy to .env and fill in. .env is git-ignored and its values are never logged, written to a
# manifest, or shown in the app - the UI only reports each key as configured or missing.
# The desktop app can instead keep keys in its own encrypted vault (Settings > API keys).
# Checked at startup by `uv run eqrisk doctor`.

# Required: end-of-day prices and volume (https://eodhd.com)
EODHD_API_KEY=

# Required: risk-free rate, FRED series DTB3 (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Required: SEC EDGAR asks every client to identify itself. Your name and a contact address.
# SEC's fair-access policy: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Your Name your.address@example.com

# Optional: Databento historical prices. Every request is priced with metadata.get_cost first and
# refused above sources.yaml databento.max_cost_usd.
DATABENTO_API_KEY=

# Optional: Sharadar corporate actions and fundamentals via Nasdaq Data Link.
NASDAQ_DATA_LINK_API_KEY=
